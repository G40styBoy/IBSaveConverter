<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IBSaveConverter.ViewModels.Sources"
             x:Class="IBSaveConverter.Views.Sources.PcSourceView"
             x:DataType="vm:PcSourceViewModel">
  <Grid ColumnDefinitions="*,Auto,Auto">
    <TextBox Grid.Column="0" Text="{Binding Folder, UpdateSourceTrigger=LostFocus}" Watermark="{Binding FolderHint}" />
    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
    <Button Grid.Column="2" Content="Reload" Command="{Binding ReloadCommand}" Margin="8,0,0,0" />
  </Grid>
</UserControl>
