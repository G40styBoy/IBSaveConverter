<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IBSaveConverter.ViewModels"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="820"
        x:Class="IBSaveConverter.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="IB3 Save Converter"
        Width="780" Height="840" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <!-- One character row in a single-pick list. -->
    <DataTemplate DataType="vm:SlotItem">
      <Grid ColumnDefinitions="64,*,Auto" Margin="2,4">
        <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="muted" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" />
        </StackPanel>
        <Border Grid.Column="2" IsVisible="{Binding HasBadge}" VerticalAlignment="Center"
                Background="{StaticResource CardBorder}" CornerRadius="4" Padding="8,2">
          <TextBlock Text="{Binding Badge}" FontSize="11" />
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:TargetSlotItem">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>
    <!-- One row of a "will have" preview. -->
    <DataTemplate DataType="vm:PlannedSlot">
      <Grid ColumnDefinitions="64,*,Auto" Margin="2,3">
        <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="muted" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Origin}" FontSize="12" VerticalAlignment="Center"
                   Classes="muted" Classes.new="{Binding IsNew}" />
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <!-- Deleted characters are listed but can't be picked. -->
    <Style Selector="ListBox.slots ListBoxItem" x:DataType="vm:SlotItem">
      <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBox.slots">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MaxHeight" Value="260" />
    </Style>
    <Style Selector="TextBlock.new">
      <Setter Property="Foreground" Value="{StaticResource StepText}" />
    </Style>
    <Style Selector="TextBlock.option">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="24,20,24,10" Spacing="4">
      <TextBlock Classes="title" Text="Infinity Blade III Save Converter" />
      <TextBlock Classes="muted" Text="Move characters between the PC version and the Android port." />
    </StackPanel>

    <TabControl Margin="12,0,12,0" Padding="0,8,0,0">

      <!-- ===================== PC -> Android ===================== -->
      <TabItem Header="PC → Android">
        <DockPanel DataContext="{Binding PcToAndroid}" x:DataType="vm:PcToAndroidViewModel">

          <Border DockPanel.Dock="Bottom" Padding="12,10,12,14" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="10">
              <Border Classes="status" Classes.success="{Binding Status.IsSuccess}" Classes.error="{Binding Status.IsError}"
                      IsVisible="{Binding Status.IsVisible}">
                <TextBlock Text="{Binding Status.Text}" TextWrapping="Wrap" />
              </Border>
              <Grid ColumnDefinitions="*,Auto,Auto">
                <ProgressBar Grid.Column="0" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="1" Content="Show in folder" Command="{Binding RevealOutputCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Classes="accent big" Content="Make Android save" Command="{Binding ConvertCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <ScrollViewer>
            <StackPanel Margin="12,4,12,16" Spacing="12" IsEnabled="{Binding IsIdle}">

              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Classes="step" Text="PC SAVE FOLDER" />
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0" Text="{Binding PcFolder, UpdateSourceTrigger=LostFocus}"
                             Watermark="Documents\My Games\Infinity Blade III\SwordGame\Cloud" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowsePcFolderCommand}" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="Reload" Command="{Binding ReloadCommand}" Margin="8,0,0,0" />
                  </Grid>
                  <TextBlock Classes="warning" Text="{Binding FolderNote}" IsVisible="{Binding HasFolderNote}" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="Have a single save file too, or instead?" />
                    <Button Content="Add save file…" Command="{Binding AddSaveFileCommand}" FontSize="12" Padding="10,3" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="card" IsEnabled="{Binding CanPickCharacters}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="step" Text="CHARACTERS TO BRING" />
                  <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SlotItem">
                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsSelectable}" Margin="0,2"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                          <Grid ColumnDefinitions="64,*,Auto,Auto" Margin="4,0,0,0">
                            <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="muted" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" />
                            </StackPanel>
                            <Border Grid.Column="2" IsVisible="{Binding HasBadge}" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Background="{StaticResource CardBorder}" CornerRadius="4" Padding="8,2">
                              <TextBlock Text="{Binding Badge}" FontSize="11" />
                            </Border>
                            <Button Grid.Column="3" Content="Remove" IsVisible="{Binding IsFromFile}" Command="{Binding RemoveCommand}"
                                    FontSize="12" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center" />
                          </Grid>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="card" IsEnabled="{Binding AreCharactersReady}">
                <StackPanel Spacing="10">
                  <TextBlock Classes="step" Text="ANDROID SAVE" />
                  <TextBlock Classes="muted" FontSize="12"
                             Text="The Android game loads one file with all of your characters in it. Loading this file replaces what's on the phone now." />

                  <RadioButton GroupName="androidSave" IsChecked="{Binding IsNewSave}">
                    <StackPanel Spacing="1">
                      <TextBlock Classes="option" Text="Start a new Android save" />
                      <TextBlock Classes="muted" FontSize="12" Text="Holds only the characters you picked above." />
                    </StackPanel>
                  </RadioButton>
                  <RadioButton GroupName="androidSave" IsChecked="{Binding IsAddToExisting}">
                    <StackPanel Spacing="1">
                      <TextBlock Classes="option" Text="Add to an Android save I already have" />
                      <TextBlock Classes="muted" FontSize="12" Text="Keeps its characters. Pick the zip you exported from the phone." />
                    </StackPanel>
                  </RadioButton>

                  <StackPanel Spacing="8" IsVisible="{Binding IsAddToExisting}" Margin="28,0,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Grid.Column="0" Text="{Binding ExistingZip, UpdateSourceTrigger=LostFocus}" Watermark="The zip the Android game exported" />
                      <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseExistingCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Classes="warning" Text="{Binding ExistingNote}" IsVisible="{Binding HasExistingNote}" />
                  </StackPanel>

                  <StackPanel Spacing="4" IsVisible="{Binding HasPlan}" Margin="0,4,0,0">
                    <TextBlock Text="{Binding PlanTitle}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Plan}" />
                  </StackPanel>
                  <TextBlock Classes="warning" Text="{Binding PlanWarning}" IsVisible="{Binding HasPlanWarning}" />
                </StackPanel>
              </Border>

              <Border Classes="card" IsEnabled="{Binding IsAndroidSaveReady}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="step" Text="SAVE AS" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding OutputZip}" Watermark="Where to save the Android zip" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" />
                  </Grid>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- ===================== Android -> PC ===================== -->
      <TabItem Header="Android → PC">
        <DockPanel DataContext="{Binding AndroidToPc}" x:DataType="vm:AndroidToPcViewModel">

          <Border DockPanel.Dock="Bottom" Padding="12,10,12,14" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="10">
              <Border Classes="status" Classes.success="{Binding Status.IsSuccess}" Classes.error="{Binding Status.IsError}"
                      IsVisible="{Binding Status.IsVisible}">
                <TextBlock Text="{Binding Status.Text}" TextWrapping="Wrap" />
              </Border>
              <Grid ColumnDefinitions="*,Auto,Auto">
                <ProgressBar Grid.Column="0" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="1" Content="Show backup" Command="{Binding RevealBackupCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Classes="accent big" Content="Install on PC" Command="{Binding InstallCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <ScrollViewer>
            <StackPanel Margin="12,4,12,16" Spacing="12" IsEnabled="{Binding IsIdle}">

              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Classes="step" Text="ANDROID SAVE" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding ZipPath, UpdateSourceTrigger=LostFocus}" Watermark="The zip the Android game exported" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseZipCommand}" Margin="8,0,0,0" />
                  </Grid>
                  <TextBlock Text="{Binding FileSourceText}" IsVisible="{Binding IsFromFile}" FontWeight="SemiBold" />
                  <TextBlock Classes="warning" Text="{Binding ZipNote}" IsVisible="{Binding HasZipNote}" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="Have a single save file instead?" />
                    <Button Content="Choose save file…" Command="{Binding ChooseSaveFileCommand}" FontSize="12" Padding="10,3" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="card" IsEnabled="{Binding IsPcStepEnabled}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="step" Text="PC SAVE FOLDER" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding PcFolder, UpdateSourceTrigger=LostFocus}"
                             Watermark="Documents\My Games\Infinity Blade III\SwordGame\Cloud" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowsePcFolderCommand}" Margin="8,0,0,0" />
                  </Grid>
                  <TextBlock Classes="muted" Text="{Binding PcNote}" IsVisible="{Binding HasPcNote}" />
                </StackPanel>
              </Border>

              <Border Classes="card" IsEnabled="{Binding IsPcReady}">
                <StackPanel Spacing="10">
                  <TextBlock Classes="step" Text="WHAT TO BRING OVER" />

                  <RadioButton GroupName="bring" IsChecked="{Binding IsWholeSave}" IsEnabled="{Binding CanBringWholeSave}">
                    <StackPanel Spacing="1">
                      <TextBlock Classes="option" Text="{Binding WholeSaveLabel}" />
                      <TextBlock Classes="muted" FontSize="12" Text="Every character, in the same slots. They replace the characters on this PC." />
                    </StackPanel>
                  </RadioButton>
                  <RadioButton GroupName="bring" IsChecked="{Binding IsOneCharacter}">
                    <StackPanel Spacing="1">
                      <TextBlock Classes="option" Text="One character" />
                      <TextBlock Classes="muted" FontSize="12" Text="Pick a character and a PC slot. The other characters on this PC stay." />
                    </StackPanel>
                  </RadioButton>

                  <StackPanel Spacing="8" IsVisible="{Binding IsOneCharacter}" Margin="28,0,0,0">
                    <ListBox Classes="slots" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" />
                    <TextBlock Text="Put it in" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <ComboBox ItemsSource="{Binding TargetSlots}" SelectedItem="{Binding SelectedTarget}"
                              HorizontalAlignment="Stretch" PlaceholderText="Choose a PC slot" />
                  </StackPanel>

                  <StackPanel Spacing="4" IsVisible="{Binding HasPlan}" Margin="0,4,0,0">
                    <TextBlock Text="Your PC will have:" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Plan}" />
                  </StackPanel>
                  <TextBlock Classes="warning" Text="{Binding ReplaceWarning}" IsVisible="{Binding HasReplaceWarning}" />
                  <TextBlock Classes="muted" FontSize="12" Text="Close Infinity Blade III before installing." />
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
